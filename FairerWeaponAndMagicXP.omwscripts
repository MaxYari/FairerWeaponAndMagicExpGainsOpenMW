# Load after MaxYariScriptServices.omwscripts (required). Most of it is the player's own experience,
# and I.SkillProgression, which it goes through, exists only on the player.
PLAYER: scripts/MaxYari/FairerWeaponAndMagicXP/player.lua
# Wraps I.Combat's pick of the armor piece a hit lands on, to see a hit on bound armor.
PLAYER: scripts/MaxYari/FairerWeaponAndMagicXP/combat.lua
# Tells the player how each of its attacks on an NPC or creature went: type, strength, hit or miss.
# One check per hit taken, nothing per frame.
NPC, CREATURE: scripts/MaxYari/FairerWeaponAndMagicXP/actor.lua
